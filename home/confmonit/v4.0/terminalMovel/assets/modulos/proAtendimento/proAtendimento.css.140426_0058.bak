#proAtendimento {
    box-sizing: border-box;
    height: 100%;
    display: flex;
    flex-direction: column;
    opacity: 1;
    min-height: 0;
}
#proAtendimento_titulo {
    height: 40px;
    flex: 0 0 40px;
    text-align: center;
   
}

#proAtendimento_responsivo {
    height: auto;
    display: flex;
    flex-wrap: wrap;
    padding: 0 5px;
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    align-items: start;
    text-align: center;
}

#proAtendimento_responsivo .table {
    table-layout: fixed;
}

/* Cores por nível na lista de processos – todas as células da linha */
#proAtendimento_responsivo .table tbody tr.table-secondary td { background-color: #d1d1d1 !important; }
#proAtendimento_responsivo .table tbody tr.table-success td   { background-color: #a1beb1 !important; }
#proAtendimento_responsivo .table tbody tr.table-primary td   { background-color: #90aad1 !important; }
#proAtendimento_responsivo .table tbody tr.table-warning td   { background-color: #faf1d8 !important; }
#proAtendimento_responsivo .table tbody tr.table-danger td    { background-color: #e0bfc2 !important; }
/* Texto preto em todas as células da lista de processos (sobrescreve .fmt-color) */
#proAtendimento_responsivo .table tbody td,
#proAtendimento_responsivo .table tbody td.click { color: #000000 !important; }
/* Ícones dos botões (headset, olho, chave) continuam brancos */
#proAtendimento_responsivo .table tbody tr td.bg-success {
    background-color: #198754 !important;
    color: #fff !important;
}

#proAtendimento_responsivo .table tbody tr td.bg-primary {
    background-color: #0d6efd !important;
    color: #fff !important;
}


#proAtendimento_responsivo .table tbody tr td.bg-danger {
    background-color: #dc3545 !important; /* fundo vermelho */
    color: #fff !important;
}

#proAtendimento_responsivo .table tbody tr td.bg-warning {
    background-color: #ffc107 !important; /* fundo amarelo */
    color: inherit !important;           /* mantém a cor do ícone */
}

.proAtendimento-dot{
    display:inline-block;
    width:14px;
    height:14px;
    border-radius:50%;
    margin-right:6px;
    border:2px solid #fff;
    vertical-align:middle;
}

.dot-secondary{ background:#6c757d; }
.dot-success{ background:#198754; }
.dot-primary{ background:#0d6efd; }
.dot-warning{ background:#ffc107; }
.dot-danger{ background:#dc3545; }


.proAtendimento-semProcesso{
    background-color: #adb5bd !important;
    color: #fff !important;
    font-weight: 500;
    text-align: center;
}

.proAtendimento-infoRow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
}

.proAtendimento-infoMain {
    text-align: left;
    font-weight: 600;
    flex: 1;
    min-width: 0;
    word-break: break-word;
}

.proAtendimento-operador {
    font-size: 10px;
    font-weight: 500;
    margin-top: 2px;
}

.proAtendimento-statusWrap {
    display: inline-flex;
    gap: 6px;
    flex-shrink: 0;
}

.proAtendimento-statusIcon {
    min-width: 30px;
    height: 30px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
}

.proAtendimento-actionBarCell {
    padding: 6px !important;
}

.proAtendimento-actionBar {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
}

.proAtendimento-mainActionBtn {
    border: 0;
    min-height: 50px;
    font-size: 1.25rem;
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
}

.proAtendimento-mainActionBtn.bg-warning {
    color: #212529;
}

#proAtendimento_responsivo .table tbody tr.proAtendimento-itemMainRow td {
    border-bottom-width: 0 !important;
}

#proAtendimento_responsivo .table tbody tr.proAtendimento-itemActionRow td {
    border-top-width: 0 !important;
    border-bottom: 8px solid #4f5358 !important;
}

@media (max-width: 768px) {
    #proAtendimento_responsivo .table td {
        font-size: 12px;
        vertical-align: middle;
    }

    #proAtendimento_responsivo .table td.proAtendimento-mainAction {
        min-width: 52px;
        height: 52px;
    }

    #proAtendimento_responsivo .table td.proAtendimento-mainAction i {
        font-size: 1.15rem;
    }

    #proAtendimento_responsivo .table td[tipo=proAtendimento_btnDadosCliente] {
        font-size: 1.05rem;
        font-weight: 600;
    }

    .proAtendimento-mainActionBtn {
        min-height: 56px;
        font-size: 1.35rem;
    }
}