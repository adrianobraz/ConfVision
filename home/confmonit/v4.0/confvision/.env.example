# Copie para .env e preencha os valores reais.
# Nunca commite .env com senhas.
# Antes de subir ao core-4: .\scripts\prepare-env-for-linux.ps1 (LF, sem BOM)

TITULO_SITE=Central de Cameras
URL_API=http://SEU_SERVIDOR:2010
URL_API_SETOR=http://SEU_SERVIDOR:2000
PORTA=8086
BIND_HOST=127.0.0.1
COOKIE_SECURE=SIM
HTTPS=NAO

# Xano — cobranca/licenca (permanece). Operacional vis_* = Postgres (XANO_BASE_URL vazio)
XANO_BASE_URL=
XANO_CVG_BASE_URL=
XANO_API_FRANQUEADO_PRO=

# Postgres/apifunction — marca central (whitelabel por Host)
APIFUNCTION_URL=http://185.130.61.4:20001

# MySQL ConfMonit (UsaConfVision)
BD_HOST_MV4=
BD_PORT_MV4=3306
BD_USER_MV4=
BD_PASS_MV4=
BD_BASE_MV4=confmonitV4

HASHKEY=
BLOCKKEY=

URL_RECEPTOR=
URL_COMANDO=

# MediaMTX — Ao vivo (HLS no browser) + publish RTMP/RTSP
MEDIAMTX_HLS_BASE=https://hls1.exemplo.com.br
MEDIAMTX_HLS_PUBLIC=
MEDIAMTX_RTMP_PUBLISH_BASE=rtmp://srv1.exemplo.com.br:1935
MEDIAMTX_RTMP_PUBLIC=
MEDIAMTX_RTSP_BASE=rtsp://srv1.exemplo.com.br:8554

# Guard RTMP (app ConfVision na VPS foxpro)
RTMP_GUARD_URL=
RTMP_WATCH_URL=
RTMP_GUARD_ADMIN_KEY=
RTMP_PUBLISH_SECRET=
ADMINISTRATOR_USER=
ADMINISTRATOR_PASS=

PROVISIONER_URL=http://127.0.0.1:2015
PROVISIONER_KEY=

CONTABO_S3_ACCESS_KEY=
CONTABO_S3_SECRET_KEY=
CONTABO_S3_ENDPOINT=https://usc1.contabostorage.com
CONTABO_S3_BUCKET=confvision
CONTABO_S3_REGION=us-east-1
CONTABO_S3_TENANT_ID=

CAD_SNAPSHOT_MAX_BYTES=51200
CAD_SNAPSHOT_MAX_WIDTH=1280

# Postgres central — dados operacionais ConfVision (vis_*)
POSTGRES_URL=postgres://confmonit:SENHA@191.96.156.116:5432/confmonit?sslmode=disable
# Coleta relatório operacional (health/metric/stream) — migration automática no boot
COLETA_RELATORIO_ENABLED=1
COLETA_RELATORIO_INTERVAL=30m
SMTP_SECRET_KEY=
VIS_WORKER_API_KEY=
CONFVISION_GRADE_WORKER_KEY=
VIS_RECEPTOR_BEARER=1e2d2eef75ccd7cfea2e06d7ce1c63c4

# Terminal — notifica receptorWeb (CV01) apos snapshot analitico
RECEPTOR_WEB_URL=http://127.0.0.1:5000
RECEPTOR_WEB_SENHA=
TERMINAL_NOTIFY_ENABLED=true
TERMINAL_NOTIFY_RETRIES=3
TERMINAL_CONTACT_ID=CV01

# Integracao Moni — imagens publicas (Hashids) + dispatch
IMAGEM_PUBLIC_SECRET=
IMAGEM_PUBLIC_BASE_URL=https://imagem.dnsid.com.br
IMAGEM_RATE_LIMIT_PER_MIN=60
IMAGEM_RATE_LIMIT_PER_HOUR=500
INTEGRACAO_DISPATCH_ENABLED=true

COMUNITIA_WEBHOOK_URL=
COMUNITIA_WEBHOOK_SECRET=

WEBHOOK_INBOUND_KEY=
WEBHOOK_INBOUND_ALLOWED_IPS=10.2.2.104,127.0.0.1

# Rust processors (foxpro) — D5 capacity + auto-assign (0/false desliga assign)
RUST_PROCESSOR_BASE_URLS=https://foxpro-rust-pilot.exemplo.host,https://foxpro-rust-pilot-b.exemplo.host
D5_AUTO_ASSIGN_ENABLED=1
