# Distribui câmeras analíticas entre processors (score /capacity-report). 0=desliga.
D5_AUTO_ASSIGN_ENABLED=1

# --- Coleta operacional → vis_sistema_health, vis_sistema_metric (automático no boot) ---
COLETA_RELATORIO_ENABLED=1
COLETA_RELATORIO_INTERVAL=15m

