func getControle(client *http.Client, rawURL string) (Controle, error) {
	body, status, err := doJSONRequest(client, http.MethodGet, rawURL, nil)
	if err != nil {
		return Controle{}, err
	}
	if status < 200 || status >= 300 {
		return Controle{}, &httpStatusError{Code: status}
	}

	// Endpoint pode retornar:
	// [] | {} | {"dados":[]} | {"dados":{}} | {"data":[...]}.
	var raw any
	if err := json.Unmarshal(body, &raw); err != nil {
		return Controle{}, fmt.Errorf("controle json invalido: %w", err)
	}

	if ctrl, ok := extractControle(raw); ok {
		return ctrl, nil
	}
	return Controle{}, fmt.Errorf("controle vazio ou formato inesperado: %s", compactBody(body))
}

func extractControle(v any) (Controle, bool) {
	switch x := v.(type) {
	case []any:
		for _, it := range x {
			if ctrl, ok := extractControle(it); ok {
				return ctrl, true
			}
		}
	case map[string]any:
		// Caso base: objeto com id e lock/Lock.
		id := toInt(x["id"])
		if id != 0 {
			lock := toBool(x["Lock"])
			if _, ok := x["Lock"]; !ok {
				lock = toBool(x["lock"])
			}
			return Controle{ID: id, Lock: lock}, true
		}

		// Caso envelope: percorre chaves comuns e fallback geral.
		keys := []string{"dados", "data", "items", "result", "results", "response", "payload", "record", "controle", "Controle"}
		for _, k := range keys {
			if vv, ok := x[k]; ok {
				if ctrl, ok := extractControle(vv); ok {
					return ctrl, true
				}
			}
		}
		for _, vv := range x {
			if ctrl, ok := extractControle(vv); ok {
				return ctrl, true
			}
		}
	}
	return Controle{}, false
}

func toInt(v any) int {
	switch n := v.(type) {
	case float64:
		return int(n)
	case int:
		return n
	case int64:
		return int(n)
	case string:
		i, _ := strconv.Atoi(n)
		return i
	default:
		return 0
	}
}

func toBool(v any) bool {
	switch b := v.(type) {
	case bool:
		return b
	case string:
		return strings.EqualFold(strings.TrimSpace(b), "true")
	case float64:
		return int(b) != 0
	case int:
		return b != 0
	default:
		return false
	}
}

func compactBody(b []byte) string {
	s := strings.TrimSpace(string(b))
	if len(s) > 180 {
		return s[:180] + "..."
	}
	return s
}

// extractFilaItemsFromAny aceita resposta do Xano como array na raiz ou envelope
// (dados/data/items/...) e objeto unico em vez de lista.
func extractFilaItemsFromAny(v any) []FilaItem {
	if v == nil {
		return nil
	}
	switch x := v.(type) {
	case []any:
		var out []FilaItem
		for _, el := range x {
			if it, ok := filaItemFromAny(el); ok {
				out = append(out, it)
				continue
			}
			out = append(out, extractFilaItemsFromAny(el)...)
		}
		return out
	case map[string]any:
		if it, ok := filaItemFromAny(x); ok {
			return []FilaItem{it}
		}
		keys := []string{"dados", "data", "items", "Items", "records", "result", "results", "response", "payload", "list", "rows", "Dados", "Data"}
		var out []FilaItem
		for _, k := range keys {
			if vv, ok := x[k]; ok {
				out = append(out, extractFilaItemsFromAny(vv)...)
			}
		}
		if len(out) > 0 {
			return out
		}
		for _, vv := range x {
			out = append(out, extractFilaItemsFromAny(vv)...)
		}
		return out
	default:
		return nil
	}
}

func filaItemFromAny(v any) (FilaItem, bool) {
	b, err := json.Marshal(v)
	if err != nil {
		return FilaItem{}, false
	}
	var it FilaItem
	if err := json.Unmarshal(b, &it); err != nil {
		return FilaItem{}, false
	}
	if it.ID == 0 {
		return FilaItem{}, false
	}
	return it, true
}

func setControleLock(client *http.Client, baseURL string, id int, lock bool) error {
	target := strings.TrimRight(baseURL, "/") + "/" + strconv.Itoa(id)
	payload := map[string]any{
		"whatsprocfila_controle_id": id,
		"Lock":                      lock,
	}
	_, status, err := doJSONRequest(client, http.MethodPut, target, payload)
	if err != nil {
		return err
	}
	if status < 200 || status >= 300 {
		return &httpStatusError{Code: status}
	}
	return nil
}

func getFilaPendentes(client *http.Client, rawURL string) ([]FilaItem, error) {
	u, err := url.Parse(rawURL)
	if err != nil {
		return nil, err
	}
	q := u.Query()
	q.Set("analise", "false")
	q.Set("disparo", "false")
	u.RawQuery = q.Encode()

	body, status, err := doJSONRequest(client, http.MethodGet, u.String(), nil)
	if err != nil {
		return nil, err
	}
	if status < 200 || status >= 300 {
		return nil, &httpStatusError{Code: status}
	}

	var raw any
	if err := json.Unmarshal(body, &raw); err != nil {
		return nil, fmt.Errorf("fila json invalido: %w", err)
	}
	items := extractFilaItemsFromAny(raw)

	// Garante filtro local caso endpoint ignore querystring.
	out := make([]FilaItem, 0, len(items))
	for _, it := range items {
		if !it.Analise && !it.Disparo {
			out = append(out, it)
		}
	}
	return out, nil
}

func processItem(client *http.Client, rawURL string, item FilaItem) error {
	payload := ProcessItemPayload{
		SendMsgWhats:             item.SendMsgWhats,
		Numerowhatsapp:           item.Numerowhatsapp,
		EnviaSom:                 item.EnviaSom,
		SendAudioWhats:           item.SendAudioWhats,
		TblWhatsAppEnviadosTexto: item.TblWhatsAppEnviadosTexto,
		TblWhatsAppEnviadosAudio: item.TblWhatsAppEnviadosAudio,
		TblWhatsAppEnviadosLigar: item.TblWhatsAppEnviadosLigar,
		Ligar:                    item.Ligar,
		IDFranqueado:             item.IDFranqueado,
		Nomecliente:              item.Nomecliente,
		Empresanome:              item.Empresanome,
		Tipoevento:               item.Tipoevento,
		Zona:                     item.Zona,
		Local:                    item.Local,
		IDEvento:                 item.IDEvento,
		Datahorario:              item.Datahorario,
		IDEventgo:                item.IDEventgo,
		Enviartexto:              item.Enviartexto,
		IDProcesso:               item.IDProcesso,
		IDDispositivo:            item.IDDispositivo,
		Notificarsempre:          item.Notificarsempre,
		DispNome:                 item.DispNome,
		DispDescricao:            item.DispDescricao,
		DispTipo:                 item.DispTipo,
	}

	_, status, err := doJSONRequest(client, http.MethodPost, rawURL, payload)
	if err != nil {
		return err
	}
	if status < 200 || status >= 300 {
		return &httpStatusError{Code: status}
	}
	return nil
}

func updateFilaItem(client *http.Client, baseURL string, item FilaItem) error {
	target := strings.TrimRight(baseURL, "/") + "/" + strconv.Itoa(item.ID)
	payload := updateFilaPayload{
		WhatsappProcFilaID:       item.ID,
		SendMsgWhats:             item.SendMsgWhats,
		Numerowhatsapp:           item.Numerowhatsapp,
		EnviaSom:                 item.EnviaSom,
		SendAudioWhats:           item.SendAudioWhats,
		TblWhatsAppEnviadosTexto: item.TblWhatsAppEnviadosTexto,
		TblWhatsAppEnviadosAudio: item.TblWhatsAppEnviadosAudio,
		TblWhatsAppEnviadosLigar: item.TblWhatsAppEnviadosLigar,
		Ligar:                    item.Ligar,
		IDFranqueado:             item.IDFranqueado,
		Nomecliente:              item.Nomecliente,
		Empresanome:              item.Empresanome,
		GRUPOFALHA:               item.GRUPOFALHA,
		Tipoevento:               item.Tipoevento,
		Zona:                     item.Zona,
		Local:                    item.Local,
		IDEvento:                 item.IDEvento,
		Datahorario:              item.Datahorario,
		IDEventgo:                item.IDEventgo,
		Enviartexto:              item.Enviartexto,
		IDProcesso:               item.IDProcesso,
		IDDispositivo:            item.IDDispositivo,
		Notificarsempre:          item.Notificarsempre,
		DispNome:                 item.DispNome,
		DispDescricao:            item.DispDescricao,
		DispTipo:                 item.DispTipo,
		Analise:                  item.Analise,
		Zonauser:                 item.Zonauser,
		Particao:                 item.Particao,
		Disparo:                  item.Disparo,
	}

	_, status, err := doJSONRequest(client, http.MethodPut, target, payload)
	if err != nil {
		return err
	}
	if status < 200 || status >= 300 {
		return &httpStatusError{Code: status}
	}
	return nil
}

func doJSONRequest(client *http.Client, method, rawURL string, payload any) ([]byte, int, error) {
	var bodyReader *bytes.Reader
	if payload == nil {
		bodyReader = bytes.NewReader(nil)
	} else {
		b, err := json.Marshal(payload)
		if err != nil {
			return nil, 0, err
		}
		bodyReader = bytes.NewReader(b)
	}

	ctx, cancel := context.WithTimeout(context.Background(), client.Timeout)
	defer cancel()

	req, err := http.NewRequestWithContext(ctx, method, rawURL, bodyReader)
	if err != nil {
		return nil, 0, err
	}
	req.Header.Set("Content-Type", "application/json")

	resp, err := client.Do(req)
	if err != nil {
		return nil, 0, err
	}
	defer resp.Body.Close()

	respBody, err := io.ReadAll(resp.Body)
	if err != nil {
		return nil, resp.StatusCode, err
	}
	return respBody, resp.StatusCode, nil
}

type httpStatusError struct {
	Code int
}

func (e *httpStatusError) Error() string {
	return "status HTTP invalido: " + strconv.Itoa(e.Code)
}

func randomBetween(rng *rand.Rand, min, max int) int {
	if max <= min {
		return min
	}
	return rng.Intn(max-min+1) + min
}

// loadDotEnv le .env no diretorio de trabalho ou ao lado do binario.
// Nao sobrescreve variaveis ja definidas no ambiente (ex.: systemd).
func loadDotEnv() {
	paths := []string{".env"}
	if exe, err := os.Executable(); err == nil {
		paths = append(paths, filepath.Join(filepath.Dir(exe), ".env"))
	}
	for _, p := range paths {
		if applyDotEnvFile(p) {
			return
		}
	}
}

func applyDotEnvFile(filename string) bool {
	b, err := os.ReadFile(filename)
	if err != nil {
		return false
	}
	text := strings.ReplaceAll(string(b), "\r\n", "\n")
	lines := strings.Split(text, "\n")
	out := make(map[string]string)
	for _, line := range lines {
		line = strings.TrimSpace(line)
		if line == "" || strings.HasPrefix(line, "#") {
			continue
		}
		if strings.HasPrefix(line, "export ") {
			line = strings.TrimSpace(strings.TrimPrefix(line, "export "))
		}
		idx := strings.IndexByte(line, '=')
		if idx <= 0 {
			continue
		}
		key := strings.TrimSpace(line[:idx])
		val := strings.TrimSpace(line[idx+1:])
		if len(val) >= 2 && val[0] == '"' && val[len(val)-1] == '"' {
			val = val[1 : len(val)-1]
		}
		out[key] = val
	}
	for k, v := range out {
		if os.Getenv(k) == "" {
			os.Setenv(k, v)
		}
	}
	return true
}

func getenv(key, fallback string) string {
	v := os.Getenv(key)
	if v == "" {
		return fallback
	}
	return v
}

func getenvInt(key string, fallback int) int {
	v := os.Getenv(key)
	if v == "" {
		return fallback
	}
	out, err := strconv.Atoi(v)
	if err != nil {
		log.Printf("valor invalido em %s=%q, usando fallback=%d", key, v, fallback)
		return fallback
	}
	return out
}

func getenvSeconds(key string, fallbackSec int) time.Duration {
	v := os.Getenv(key)
	if v == "" {
		return time.Duration(fallbackSec) * time.Second
	}
	sec, err := strconv.Atoi(v)
	if err != nil || sec <= 0 {
		log.Printf("valor invalido em %s=%q, usando fallback=%ds", key, v, fallbackSec)
		return time.Duration(fallbackSec) * time.Second
	}
	return time.Duration(sec) * time.Second
}
