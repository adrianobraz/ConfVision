var running int32
var runningLigacao int32
var pendingWhatsAppCycle int32

func main() {
	loadDotEnv()
	cfg := loadConfig()
	rng := rand.New(rand.NewSource(time.Now().UnixNano()))
	notifyCh := make(chan struct{}, 64)

	client := &http.Client{
		Timeout: cfg.Timeout,
	}

	log.Printf("taskxano iniciado | interval=%s | timeout=%s | retries=%d", cfg.Interval, cfg.Timeout, cfg.Retries)
	if cfg.DisparaWhatsappURL != "" {
		log.Printf("whatsapp modo=XANO (GET fn_DisparaWhatsapp) | url=%s", cfg.DisparaWhatsappURL)
	} else {
		procMode := "sequencial"
		if cfg.WhatsAppAsyncConcurrency > 1 {
			procMode = fmt.Sprintf("goroutines paralelas (limite=%d)", cfg.WhatsAppAsyncConcurrency)
		}
		log.Printf("whatsapp modo=ITEMS | fn_AlarmeEventos_Pendente=GET %s | FuncaoSis_WhatsappProcFila=POST %s (%s) | fila_get=%s | controle_get=%s",
			cfg.AlarmeEventosPendenteURL, cfg.ProcessItemURL, procMode, cfg.FilaGetURL, cfg.ControleGetURL)
	}
	if cfg.LigacaoEnabled() {
		log.Printf("fila ligacao | interval=%s | task_get=%s | ligacao_fila=%s | ligar_process=%s",
			cfg.LigacaoInterval, cfg.TaskGetURL, cfg.LigacaoFilaGetURL, cfg.LigacaoProcessURL)
	}
	notifyServer := startNotifyServer(cfg, notifyCh)
	if notifyServer != nil {
		defer shutdownHTTPServer(notifyServer)
	}

	shutdown := make(chan struct{})
	if cfg.LigacaoEnabled() {
		go runLigacaoLoop(client, cfg, shutdown)
	}

	// Roda uma vez ao iniciar.
	runOnce(client, cfg, rng, false)

	ticker := time.NewTicker(cfg.Interval)
	defer ticker.Stop()

	stop := make(chan os.Signal, 1)
	signal.Notify(stop, syscall.SIGINT, syscall.SIGTERM)

	for {
		select {
		case <-ticker.C:
			runOnce(client, cfg, rng, false)
		case <-notifyCh:
			log.Printf("notificacao recebida via /notify, executando ciclo imediato")
			runOnce(client, cfg, rng, true)
		case sig := <-stop:
			log.Printf("sinal recebido (%s), encerrando", sig.String())
			close(shutdown)
			return
		}
	}
}

type Config struct {
	Interval           time.Duration
	Timeout            time.Duration
	Retries            int
	FilaGetURL         string
	FilaPutBaseURL     string
	ControleGetURL     string
	ControlePutBaseURL string
	ProcessItemURL     string
	// DisparaWhatsappURL: GET no endpoint Xano que executa a function fn_DisparaWhatsapp inteira (lock, fila, envios).
	// Se preenchido, ignora PROCESS_ITEM_URL e o loop local — igual a task antiga no Xano.
	DisparaWhatsappURL string
	// AlarmeEventosPendenteURL: GET na API Xano que executa fn_AlarmeEventos_Pendente (uma vez por ciclo, depois do lock).
	AlarmeEventosPendenteURL string
	// WhatsAppAsyncConcurrency: paralelismo ao chamar FuncaoSis_WhatsappProcFila (similar a async-shared). 1 = sequencial com pausas.
	WhatsAppAsyncConcurrency int
	NotifyListenAddr         string
	NotifyAPIKey             string
	// NotifyFilaRetryAttempts: apos /notify, reconsulta a fila N vezes se vier vazia (corrige race Xano insert vs GET).
	NotifyFilaRetryAttempts int
	NotifyFilaRetryDelay    time.Duration
	// FilaLigacao (task Xano migrada)
	LigacaoInterval        time.Duration
	TaskGetURL             string
	TaskPutBaseURL         string
	TaskRowID              int
	LigacaoFilaGetURL      string
	LigacaoFilaDeleteBase  string
	WhatsappLigarErroBase  string
	LigacaoProcessURL      string
}

func (c Config) LigacaoEnabled() bool {
	return strings.TrimSpace(c.LigacaoProcessURL) != ""
}

func loadConfig() Config {
	return Config{
		// Task critica: roda a cada 30s por padrao.
		Interval: getenvSeconds("INTERVAL_SECONDS", 30),
		// Timeout maior para aguentar a funcao com sleeps no Xano.
		Timeout: getenvSeconds("HTTP_TIMEOUT_SECONDS", 90),
		// Tentativa inicial + N retries.
		Retries: getenvInt("RETRIES", 2),
		FilaGetURL: getenv("XANO_FILA_GET_URL", "https://xpcy-oyme-lno7.b2.xano.io/api:PJcUZdmd/whatsappprocfila"),
		FilaPutBaseURL: getenv("XANO_FILA_PUT_BASE_URL", "https://xpcy-oyme-lno7.b2.xano.io/api:PJcUZdmd/whatsappprocfila"),
		ControleGetURL: getenv("XANO_CONTROLE_GET_URL", "https://xpcy-oyme-lno7.b2.xano.io/api:PJcUZdmd/whatsprocfila_controle"),
		ControlePutBaseURL: getenv("XANO_CONTROLE_PUT_BASE_URL", "https://xpcy-oyme-lno7.b2.xano.io/api:PJcUZdmd/whatsprocfila_controle"),
		// Equivale a function.run FuncaoSis_WhatsappProcFila no Xano (POST, corpo = campos do item da fila).
		ProcessItemURL: getenv("PROCESS_ITEM_URL", "https://xpcy-oyme-lno7.b2.xano.io/api:PJcUZdmd/FuncaoSis_WhatsappProcFila"),
		// Se nao vazio: um GET substitui o loop local (fn_DisparaWhatsapp inteira no Xano).
		DisparaWhatsappURL: getenv("DISPARA_WHATSAPP_URL", ""),
		// Equivale a fn_AlarmeEventos_Pendente: GET na API AlarmeEventos_Pendente (apos lock).
		AlarmeEventosPendenteURL: getenv("ALARME_EVENTOS_PENDENTE_URL", "https://xpcy-oyme-lno7.b2.xano.io/api:PJcUZdmd/AlarmeEventos_Pendente"),
		// >=2: POST FuncaoSis em paralelo (goroutines, estilo async-shared). 1: sequencial com pausas como no foreach do Xano.
		WhatsAppAsyncConcurrency: getenvInt("WHATSAPP_ASYNC_CONCURRENCY", 5),
		NotifyListenAddr: getenv("NOTIFY_LISTEN_ADDR", ":8081"),
		NotifyAPIKey:     getenv("NOTIFY_API_KEY", ""),
		NotifyFilaRetryAttempts: getenvInt("NOTIFY_FILA_RETRY_ATTEMPTS", 12),
		NotifyFilaRetryDelay:    time.Duration(getenvInt("NOTIFY_FILA_RETRY_DELAY_MS", 250)) * time.Millisecond,
		LigacaoInterval: getenvSeconds("LIGACAO_INTERVAL_SECONDS", 5),
		TaskGetURL: getenv("XANO_TASK_GET_URL", "https://xpcy-oyme-lno7.b2.xano.io/api:PJcUZdmd/task"),
		TaskPutBaseURL: getenv("XANO_TASK_PUT_BASE_URL", "https://xpcy-oyme-lno7.b2.xano.io/api:PJcUZdmd/task"),
		TaskRowID: getenvInt("TASK_ROW_ID", 1),
		LigacaoFilaGetURL: getenv("XANO_LIGACAO_FILA_GET_URL", "https://xpcy-oyme-lno7.b2.xano.io/api:PJcUZdmd/ligacaofila"),
		LigacaoFilaDeleteBase: getenv("XANO_LIGACAO_FILA_DELETE_BASE", "https://xpcy-oyme-lno7.b2.xano.io/api:PJcUZdmd/ligacaofila"),
		WhatsappLigarErroBase: getenv("XANO_WHATSAPP_LIGAR_ERRO_BASE", "https://xpcy-oyme-lno7.b2.xano.io/api:PJcUZdmd/whatsappligarerro"),
		LigacaoProcessURL: getenv("LIGACAO_PROCESS_URL", ""),
	}
}

func startNotifyServer(cfg Config, notifyCh chan<- struct{}) *http.Server {
	if strings.TrimSpace(cfg.NotifyListenAddr) == "" {
		log.Printf("notify server desabilitado (NOTIFY_LISTEN_ADDR vazio)")
		return nil
	}

	mux := http.NewServeMux()
	mux.HandleFunc("/healthz", func(w http.ResponseWriter, _ *http.Request) {
		w.Header().Set("Content-Type", "application/json")
		w.WriteHeader(http.StatusOK)
		_, _ = w.Write([]byte(`{"ok":true}`))
	})
	mux.HandleFunc("/notify", func(w http.ResponseWriter, r *http.Request) {
		if r.Method != http.MethodPost {
			log.Printf("notify: ignorado metodo=%s de %s (obrigatorio POST)", r.Method, r.RemoteAddr)
			w.Header().Set("Allow", http.MethodPost)
			w.WriteHeader(http.StatusMethodNotAllowed)
			return
		}

		if cfg.NotifyAPIKey != "" {
			got := strings.TrimSpace(r.Header.Get("X-Task-Key"))
			if got != cfg.NotifyAPIKey {
				log.Printf("notify: X-Task-Key invalido ou ausente de %s", r.RemoteAddr)
				w.WriteHeader(http.StatusUnauthorized)
				return
			}
		}

		log.Printf("notify: POST aceito de %s", r.RemoteAddr)
		queued := true
		select {
		case notifyCh <- struct{}{}:
		default:
			queued = false
			log.Printf("notify: buffer interno cheio, evento descartado (aumente carga ou intervalo)")
		}

		w.Header().Set("Content-Type", "application/json")
		if queued {
			w.WriteHeader(http.StatusAccepted)
			_, _ = w.Write([]byte(`{"queued":true}`))
		} else {
			w.WriteHeader(http.StatusServiceUnavailable)
			_, _ = w.Write([]byte(`{"queued":false,"reason":"channel_full"}`))
		}
	})

	srv := &http.Server{
		Addr:    cfg.NotifyListenAddr,
		Handler: mux,
	}

	go func() {
		log.Printf("notify server ouvindo em %s", cfg.NotifyListenAddr)
		if err := srv.ListenAndServe(); err != nil && !errors.Is(err, http.ErrServerClosed) {
			log.Printf("erro no notify server: %v", err)
		}
	}()

	if cfg.NotifyAPIKey == "" {
		log.Printf("aviso: NOTIFY_API_KEY vazio, /notify sem autenticacao")
	}
	return srv
}

func shutdownHTTPServer(srv *http.Server) {
	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	defer cancel()
	if err := srv.Shutdown(ctx); err != nil {
		log.Printf("falha ao encerrar notify server: %v", err)
	}
}

func runOnce(client *http.Client, cfg Config, rng *rand.Rand, fromNotify bool) {
	if !atomic.CompareAndSwapInt32(&running, 0, 1) {
		atomic.StoreInt32(&pendingWhatsAppCycle, 1)
		log.Printf("execucao anterior ainda em andamento; ciclo extra agendado (notify ou timer sobreposto)")
		return
	}
	defer func() {
		atomic.StoreInt32(&running, 0)
		if atomic.CompareAndSwapInt32(&pendingWhatsAppCycle, 1, 0) {
			log.Printf("executando ciclo pendente imediatamente apos o anterior")
			go runOnce(client, cfg, rng, false)
		}
	}()

	start := time.Now()
	attempts := cfg.Retries + 1
	var lastErr error

	for attempt := 1; attempt <= attempts; attempt++ {
		if attempt > 1 {
			backoff := backoffForAttempt(attempt)
			log.Printf("retry=%d aguardando backoff=%s", attempt-1, backoff)
			time.Sleep(backoff)
		}

		err := processRoutine(client, cfg, rng, fromNotify)
		if err == nil {
			log.Printf("sucesso | attempt=%d/%d | duracao=%s", attempt, attempts, time.Since(start))
			return
		}

		lastErr = err
		log.Printf("falha | attempt=%d/%d | erro=%v", attempt, attempts, err)
	}

	log.Printf("erro final apos retries | duracao=%s | erro=%v", time.Since(start), lastErr)
}

// --- FilaLigacao (ex-task Xano FilaLigacao, freq 5s) ---

