// ligarErroJSON decodifica alarm_events_id como json.RawMessage (IDs grandes / float no JSON do Xano).
type ligarErroJSON struct {
	Franqueado      string          `json:"franqueado"`
	Telefone        string          `json:"telefone"`
	Nomecliente     string          `json:"nomecliente"`
	Empresanome     string          `json:"empresanome"`
	Tipoevento      string          `json:"tipoevento"`
	Zona            string          `json:"zona"`
	Local           string          `json:"local"`
	AlarmEventsID   json.RawMessage `json:"alarm_events_id"`
	Datahorario     string          `json:"datahorario"`
	Ideventgo       string          `json:"ideventgo"`
	IDDispositivo   string          `json:"idDispositivo"`
	IDProcesso      string          `json:"idProcesso"`
	Notificarsempre bool            `json:"notificarsempre"`
	DispNome        string          `json:"DispNome"`
	DispDescricao   string          `json:"DispDescricao"`
	DispTipo        string          `json:"DispTipo"`
}

func parseAlarmEventsIDRaw(raw json.RawMessage) int64 {
	raw = bytes.TrimSpace(raw)
	if len(raw) == 0 || bytes.Equal(raw, []byte("null")) {
		return 0
	}
	var n json.Number
	if err := json.Unmarshal(raw, &n); err == nil {
		if v, err := n.Int64(); err == nil {
			return v
		}
		f, err := strconv.ParseFloat(n.String(), 64)
		if err == nil {
			return int64(f)
		}
	}
	var s string
	if err := json.Unmarshal(raw, &s); err == nil {
		v, _ := strconv.ParseInt(s, 10, 64)
		return v
	}
	return 0
}

func runLigacaoLoop(client *http.Client, cfg Config, shutdown <-chan struct{}) {
	ticker := time.NewTicker(cfg.LigacaoInterval)
	defer ticker.Stop()
	runLigacaoOnce(client, cfg)
	for {
		select {
		case <-shutdown:
			log.Printf("fila ligacao: loop encerrado")
			return
		case <-ticker.C:
			runLigacaoOnce(client, cfg)
		}
	}
}

func runLigacaoOnce(client *http.Client, cfg Config) {
	if !atomic.CompareAndSwapInt32(&runningLigacao, 0, 1) {
		log.Printf("ligacao: execucao anterior em andamento, pulando ciclo")
		return
	}
	defer atomic.StoreInt32(&runningLigacao, 0)

	start := time.Now()
	attempts := cfg.Retries + 1
	var lastErr error
	for attempt := 1; attempt <= attempts; attempt++ {
		if attempt > 1 {
			backoff := backoffForAttempt(attempt)
			log.Printf("ligacao retry=%d backoff=%s", attempt-1, backoff)
			time.Sleep(backoff)
		}
		err := processLigacaoRoutine(client, cfg)
		if err == nil {
			log.Printf("ligacao sucesso | attempt=%d/%d | duracao=%s", attempt, attempts, time.Since(start))
			return
		}
		lastErr = err
		log.Printf("ligacao falha | attempt=%d/%d | erro=%v", attempt, attempts, err)
	}
	log.Printf("ligacao erro final | duracao=%s | erro=%v", time.Since(start), lastErr)
}

func processLigacaoRoutine(client *http.Client, cfg Config) error {
	task, err := getTaskRow(client, cfg.TaskGetURL, cfg.TaskRowID)
	if err != nil {
		return fmt.Errorf("erro ao buscar task: %w", err)
	}
	if task.Running {
		log.Printf("ligacao: task Running=true (Rodando), pulando")
		return nil
	}
	if err := setTaskRunning(client, cfg.TaskPutBaseURL, cfg.TaskRowID, true); err != nil {
		return fmt.Errorf("erro ao marcar task Running=true: %w", err)
	}
	defer func() {
		if e := setTaskRunning(client, cfg.TaskPutBaseURL, cfg.TaskRowID, false); e != nil {
			log.Printf("ligacao: falha ao liberar task Running=false: %v", e)
		}
	}()

	fila, err := getLigacaoFilaList(client, cfg.LigacaoFilaGetURL)
	if err != nil {
		return fmt.Errorf("erro ao buscar ligacaofila: %w", err)
	}
	if len(fila) == 0 {
		log.Printf("ligacao: fila vazia")
		return nil
	}
	sort.Slice(fila, func(i, j int) bool {
		return fila[i].ID < fila[j].ID
	})

	for _, row := range fila {
		erro, err := getWhatsappLigarErro(client, cfg.WhatsappLigarErroBase, row.WhatsappligarerroID)
		if err != nil {
			return fmt.Errorf("erro whiteligarerro id=%d: %w", row.WhatsappligarerroID, err)
		}
		if err := deleteLigacaoFila(client, cfg.LigacaoFilaDeleteBase, row.ID); err != nil {
			return fmt.Errorf("erro ao deletar ligacaofila id=%d: %w", row.ID, err)
		}
		payload := WhatsappLigarPayload{
			Franqueado:      erro.Franqueado,
			Telefone:        erro.Telefone,
			Nomecliente:     erro.Nomecliente,
			Empresanome:     erro.Empresanome,
			Tipoevento:      erro.Tipoevento,
			Zona:            erro.Zona,
			Local:           erro.Local,
			Datahorario:     erro.Datahorario,
			AlarmEventsID:   erro.AlarmEventsID,
			Ideventgo:       erro.Ideventgo,
			IDDispositivo:   erro.IDDispositivo,
			IDProcesso:      erro.IDProcesso,
			Notificarsempre: erro.Notificarsempre,
			DispNome:        erro.DispNome,
			DispDescricao:   erro.DispDescricao,
			DispTipo:        erro.DispTipo,
		}
		if err := postWhatsappLigar(client, cfg.LigacaoProcessURL, payload); err != nil {
			return fmt.Errorf("WhatsappLigar falhou (fila era id=%d): %w", row.ID, err)
		}
	}
	return nil
}

func getTaskRow(client *http.Client, rawURL string, wantID int) (TaskRow, error) {
	body, status, err := doJSONRequest(client, http.MethodGet, rawURL, nil)
	if err != nil {
		return TaskRow{}, err
	}
	if status < 200 || status >= 300 {
		return TaskRow{}, &httpStatusError{Code: status}
	}
	var raw any
	if err := json.Unmarshal(body, &raw); err != nil {
		return TaskRow{}, err
	}
	tr, ok := extractTaskByID(raw, wantID)
	if !ok {
		return TaskRow{}, fmt.Errorf("task id=%d nao encontrada: %s", wantID, compactBody(body))
	}
	return tr, nil
}

func extractTaskByID(v any, wantID int) (TaskRow, bool) {
	switch x := v.(type) {
	case []any:
		for _, it := range x {
			if tr, ok := extractTaskByID(it, wantID); ok {
				return tr, true
			}
		}
	case map[string]any:
		id := toInt(x["id"])
		if id == wantID {
			r := toBool(x["Running"])
			if _, ok := x["Running"]; !ok {
				r = toBool(x["running"])
			}
			return TaskRow{ID: id, Running: r}, true
		}
		for _, k := range []string{"dados", "data", "items", "result"} {
			if vv, ok := x[k]; ok {
				if tr, ok := extractTaskByID(vv, wantID); ok {
					return tr, true
				}
			}
		}
	}
	return TaskRow{}, false
}

func setTaskRunning(client *http.Client, baseURL string, id int, running bool) error {
	target := strings.TrimRight(baseURL, "/") + "/" + strconv.Itoa(id)
	payload := map[string]any{
		"task_id": id,
		"Running": running,
	}
	_, status, err := doJSONRequest(client, http.MethodPut, target, payload)
	if err != nil {
		return err
	}
	if status < 200 || status >= 300 {
		return &httpStatusError{Code: status}
	}
	return nil
}

func getLigacaoFilaList(client *http.Client, rawURL string) ([]LigacaoFilaItem, error) {
	body, status, err := doJSONRequest(client, http.MethodGet, rawURL, nil)
	if err != nil {
		return nil, err
	}
	if status < 200 || status >= 300 {
		return nil, &httpStatusError{Code: status}
	}
	var items []LigacaoFilaItem
	if err := json.Unmarshal(body, &items); err != nil {
		var wrapped struct {
			Dados []LigacaoFilaItem `json:"dados"`
			Data  []LigacaoFilaItem `json:"data"`
		}
		if err2 := json.Unmarshal(body, &wrapped); err2 != nil {
			return nil, err
		}
		switch {
		case len(wrapped.Dados) > 0:
			items = wrapped.Dados
		case len(wrapped.Data) > 0:
			items = wrapped.Data
		default:
			items = []LigacaoFilaItem{}
		}
	}
	return items, nil
}

func deleteLigacaoFila(client *http.Client, baseURL string, id int) error {
	target := strings.TrimRight(baseURL, "/") + "/" + strconv.Itoa(id)
	_, status, err := doJSONRequest(client, http.MethodDelete, target, nil)
	if err != nil {
		return err
	}
	if status < 200 || status >= 300 {
		return &httpStatusError{Code: status}
	}
	return nil
}

func getWhatsappLigarErro(client *http.Client, baseURL string, id int) (WhatsappLigarErro, error) {
	target := strings.TrimRight(baseURL, "/") + "/" + strconv.Itoa(id)
	body, status, err := doJSONRequest(client, http.MethodGet, target, nil)
	if err != nil {
		return WhatsappLigarErro{}, err
	}
	if status < 200 || status >= 300 {
		return WhatsappLigarErro{}, &httpStatusError{Code: status}
	}
	var raw any
	if err := json.Unmarshal(body, &raw); err != nil {
		return WhatsappLigarErro{}, err
	}
	b, err := json.Marshal(extractFirstObject(raw))
	if err != nil {
		return WhatsappLigarErro{}, err
	}
	var aux ligarErroJSON
	if err := json.Unmarshal(b, &aux); err != nil {
		return WhatsappLigarErro{}, err
	}
	return WhatsappLigarErro{
		Franqueado:      aux.Franqueado,
		Telefone:        aux.Telefone,
		Nomecliente:     aux.Nomecliente,
		Empresanome:     aux.Empresanome,
		Tipoevento:      aux.Tipoevento,
		Zona:            aux.Zona,
		Local:           aux.Local,
		AlarmEventsID:   parseAlarmEventsIDRaw(aux.AlarmEventsID),
		Datahorario:     aux.Datahorario,
		Ideventgo:       aux.Ideventgo,
		IDDispositivo:   aux.IDDispositivo,
		IDProcesso:      aux.IDProcesso,
		Notificarsempre: aux.Notificarsempre,
		DispNome:        aux.DispNome,
		DispDescricao:   aux.DispDescricao,
		DispTipo:        aux.DispTipo,
	}, nil
}

func extractFirstObject(v any) any {
	switch x := v.(type) {
	case map[string]any:
		if _, ok := x["id"]; ok || x["franqueado"] != nil {
			return x
		}
		for _, k := range []string{"dados", "data"} {
			if vv, ok := x[k]; ok {
				return extractFirstObject(vv)
			}
		}
	case []any:
		if len(x) > 0 {
			return extractFirstObject(x[0])
		}
	}
	return v
}

func postWhatsappLigar(client *http.Client, rawURL string, p WhatsappLigarPayload) error {
	_, status, err := doJSONRequest(client, http.MethodPost, rawURL, p)
	if err != nil {
		return err
	}
	if status < 200 || status >= 300 {
		return &httpStatusError{Code: status}
	}
	return nil
}

func processRoutine(client *http.Client, cfg Config, rng *rand.Rand, fromNotify bool) error {
	// Igual a task antiga: um GET chama a function fn_DisparaWhatsapp no Xano (tudo dentro do Xano).
	if strings.TrimSpace(cfg.DisparaWhatsappURL) != "" {
		return callDisparaWhatsappFunction(client, cfg.DisparaWhatsappURL)
	}

	if cfg.ProcessItemURL == "" {
		return errors.New("configure DISPARA_WHATSAPP_URL (GET fn_DisparaWhatsapp no Xano) ou PROCESS_ITEM_URL (POST por item)")
	}

	ctrl, err := getControle(client, cfg.ControleGetURL)
	if err != nil {
		return fmt.Errorf("erro ao buscar controle: %w", err)
	}

	if ctrl.Lock {
		log.Printf("controle lock=true, rotina em andamento, encerrando ciclo")
		return nil
	}

	if err := setControleLock(client, cfg.ControlePutBaseURL, ctrl.ID, true); err != nil {
		return fmt.Errorf("erro ao travar controle: %w", err)
	}
	defer func() {
		if unlockErr := setControleLock(client, cfg.ControlePutBaseURL, ctrl.ID, false); unlockErr != nil {
			log.Printf("falha ao liberar lock do controle: %v", unlockErr)
		}
	}()

	if strings.TrimSpace(cfg.AlarmeEventosPendenteURL) != "" {
		if err := callSimpleGET(client, cfg.AlarmeEventosPendenteURL, "AlarmeEventos_Pendente"); err != nil {
			return err
		}
	}

	items, err := getFilaPendentes(client, cfg.FilaGetURL)
	if err != nil {
		return fmt.Errorf("erro ao buscar fila: %w", err)
	}
	if fromNotify && len(items) == 0 && cfg.NotifyFilaRetryAttempts > 0 {
		for attempt := 1; attempt <= cfg.NotifyFilaRetryAttempts; attempt++ {
			time.Sleep(cfg.NotifyFilaRetryDelay)
			items, err = getFilaPendentes(client, cfg.FilaGetURL)
			if err != nil {
				return fmt.Errorf("erro ao buscar fila: %w", err)
			}
			if len(items) > 0 {
				log.Printf("notify: fila com itens apos espera (tentativa %d/%d)", attempt, cfg.NotifyFilaRetryAttempts)
				break
			}
		}
	}
	if len(items) == 0 {
		log.Printf("fila vazia")
		return nil
	}

	// Mantem comportamento similar ao sort desc no Xano.
	sort.Slice(items, func(i, j int) bool {
		return items[i].CreatedAt > items[j].CreatedAt
	})

	if cfg.WhatsAppAsyncConcurrency <= 1 {
		return processWhatsappItemsSequential(client, cfg, rng, items)
	}
	return processWhatsappItemsAsync(client, cfg, items)
}

// processWhatsappItemsSequential replica pausas do Xano (1–3s entre itens, pausa longa a cada 5).
func processWhatsappItemsSequential(client *http.Client, cfg Config, rng *rand.Rand, items []FilaItem) error {
	contador := 0
	for _, item := range items {
		contador++
		if contador > 5 {
			sleepSec := randomBetween(rng, 15, 20)
			log.Printf("pausa longa apos 5 envios: %ds", sleepSec)
			time.Sleep(time.Duration(sleepSec) * time.Second)
			contador = 1
		}

		if err := processItem(client, cfg.ProcessItemURL, item); err != nil {
			return fmt.Errorf("erro ao processar item id=%d: %w", item.ID, err)
		}

		item.Disparo = true
		if err := updateFilaItem(client, cfg.FilaPutBaseURL, item); err != nil {
			return fmt.Errorf("erro ao marcar disparo item id=%d: %w", item.ID, err)
		}

		sleepSec := randomBetween(rng, 1, 3)
		time.Sleep(time.Duration(sleepSec) * time.Second)
	}
	return nil
}

// processWhatsappItemsAsync dispara POST + PUT disparo em paralelo (limite = concorrencia), similar a runtime_mode async-shared.
func processWhatsappItemsAsync(client *http.Client, cfg Config, items []FilaItem) error {
	n := cfg.WhatsAppAsyncConcurrency
	sem := make(chan struct{}, n)
	var wg sync.WaitGroup
	var mu sync.Mutex
	var firstErr error

	for _, item := range items {
		item := item
		wg.Add(1)
		go func() {
			defer wg.Done()
			sem <- struct{}{}
			defer func() { <-sem }()

			if err := processItem(client, cfg.ProcessItemURL, item); err != nil {
				mu.Lock()
				if firstErr == nil {
					firstErr = fmt.Errorf("erro ao processar item id=%d: %w", item.ID, err)
				}
				mu.Unlock()
				return
			}
			item.Disparo = true
			if err := updateFilaItem(client, cfg.FilaPutBaseURL, item); err != nil {
				mu.Lock()
				if firstErr == nil {
					firstErr = fmt.Errorf("erro ao marcar disparo item id=%d: %w", item.ID, err)
				}
				mu.Unlock()
			}
		}()
	}
	wg.Wait()
	return firstErr
}

func callDisparaWhatsappFunction(client *http.Client, rawURL string) error {
	return callSimpleGET(client, rawURL, "DisparaWhatsapp")
}

// callSimpleGET executa GET com timeout do client (DisparaWhatsapp, AlarmeEventos_Pendente, etc.).
func callSimpleGET(client *http.Client, rawURL, label string) error {
	ctx, cancel := context.WithTimeout(context.Background(), client.Timeout)
	defer cancel()
	req, err := http.NewRequestWithContext(ctx, http.MethodGet, rawURL, nil)
	if err != nil {
		return err
	}
	req.Header.Set("Content-Type", "application/json")
	resp, err := client.Do(req)
	if err != nil {
		return fmt.Errorf("GET %s: %w", label, err)
	}
	defer resp.Body.Close()
	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
		return fmt.Errorf("%s: status HTTP invalido: %d", label, resp.StatusCode)
	}
	log.Printf("whatsapp: GET %s ok | status=%d", label, resp.StatusCode)
	return nil
}

func backoffForAttempt(attempt int) time.Duration {
	// attempt 2 -> 2s, attempt 3 -> 5s, demais -> 10s
	switch attempt {
	case 2:
		return 2 * time.Second
	case 3:
		return 5 * time.Second
	default:
		return 10 * time.Second
	}
}

