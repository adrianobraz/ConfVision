[Unit]
Description=Confmonit - Worker faturamento FranqueadoPro/ConfVision
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/confmonit/v4.0/fp-billing-worker
ExecStart=/home/confmonit/v4.0/fp-billing-worker/fp-billing-worker
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
