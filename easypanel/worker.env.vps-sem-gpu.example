# VPS sem GPU — legacy (~50 câmeras)
# EasyPanel → confvision-worker | python -u main.py
# Mount: nenhum | GPU: não

XANO_BASE_URL=https://vision.confmonit2.com.br
VIS_WORKER_API_KEY=TROCAR_IGUAL_GO_CONFVISION
EVENT_STORE=postgres
TERMINAL_NOTIFY_ENABLED=false

MEDIAMTX_RTSP_BASE=rtsp://foxpro_confvision:8554
RTMP_PUBLISH_SECRET=TROCAR_IGUAL_GO_CONFVISION

WORKER_ID=worker-docker-21
WORKER_VERSION=0.4.0
MEDIAMTX_NODE_ID=1
SYNC_INTERVAL_SEC=30
SYNC_USE_UNIFIED_API=true

CONFMONIT_API_URL=http://185.130.61.4:2010
ARMADO_CACHE_TTL_SEC=20

REDIS_URL=redis://default:SENHA@185.130.61.5:6379/0
CONFIG_CACHE_BACKEND=redis
CONFIG_CACHE_TTL_SEC=120

EVENT_QUEUE_BACKEND=redis
EVENT_QUEUE_KEY=confvision:eventos
EVENT_QUEUE_MAX_SIZE=1000

YOLO_ARCH=legacy
YOLO_MODEL=yolov8n.pt
YOLO_CONF_DEFAULT=0.5
YOLO_DEVICE=

YOLO_ONLY_ON_MOTION=1
YOLO_MOTION_FRAME_SKIP=2
YOLO_MOTION_MISS_FRAMES=2
FRAME_SKIP=5

CLIP_DURACAO_SEG=20
SNAPSHOT_JPEG_QUALITY=85
CAPTURE_DIR=/tmp/confvision
UPLOAD_WORKERS=4
UPLOAD_RETRIES=3
CAPTURE_WORKERS=9

SHARD_MODE=auto
WORKER_SHARD_INDEX=-1
WORKER_SHARD_TOTAL=2
MAX_CAMERAS=50

CONTABO_S3_ACCESS_KEY=
CONTABO_S3_SECRET_KEY=
CONTABO_S3_ENDPOINT=https://usc1.contabostorage.com
CONTABO_S3_BUCKET=confvision
CONTABO_S3_REGION=us-east-1
CONTABO_S3_TENANT_ID=

SENSOR_POLL_INTERVAL_SEC=10
RTMP_AUTH_CACHE_SEC=300
