XANO_BASE_URL=https://xpcy-oyme-lno7.b2.xano.io/api:AC7rgWwW
# API ConfMonit — consulta armado do dispositivo (somente_armado)
CONFMONIT_API_URL=http://185.130.61.4:2010
# Worker usa /v4/dispositivo/workerGetArmadoById (rota nova, sem JWT)
# CONFMONIT_API_TOKEN=  # opcional
ARMADO_CACHE_TTL_SEC=20
MEDIAMTX_RTSP_BASE=rtsp://foxpro_confvision:8554
# Path RTMP/HLS/RTSP: {hash12+} = Hashids(vis_camera.id), salt=RTMP_PUBLISH_SECRET
# Alfabeto 0-9a-z, min_length=12 — sem prefixo /live/
# RTMP_PUBLISH_SECRET obrigatório em guard, Go e workers que leem o stream
WORKER_ID=worker-docker-01
WORKER_VERSION=0.3.0
SYNC_INTERVAL_SEC=30
FRAME_SKIP=5
YOLO_MODEL=yolov8n.pt
YOLO_CONF_DEFAULT=0.5

# GPU (servidor dedicado): cuda:0 | deixe vazio para auto-detect
YOLO_DEVICE=

# Duracao de cada clip de evento (segundos)
CLIP_DURACAO_SEG=20
SNAPSHOT_JPEG_QUALITY=85

# Pasta temporaria para capturas locais antes do upload Contabo
CAPTURE_DIR=/tmp/confvision
UPLOAD_WORKERS=4
UPLOAD_RETRIES=3

# --- Escala nacional (20k+ cameras) ---
# Modo shard: auto | worker_id | hash
# auto: usa worker_id se definido, senao hash por camera id
SHARD_MODE=auto
# Hash: camera_id % WORKER_SHARD_TOTAL == WORKER_SHARD_INDEX
# Ex.: 400 workers => WORKER_SHARD_TOTAL=400, indices 0..399
WORKER_SHARD_INDEX=-1
WORKER_SHARD_TOTAL=0
# Maximo de cameras RTSP simultaneas neste container
MAX_CAMERAS=50

# Fila deteccao -> captura (memory=teste local | redis=producao)
EVENT_QUEUE_BACKEND=memory
REDIS_URL=
EVENT_QUEUE_KEY=confvision:eventos
EVENT_QUEUE_MAX_SIZE=1000
CAPTURE_WORKERS=8

# Terminal — worker posta direto no receptorWeb (assincrono, sem Xano)
# Contact ID CENTRAL: CV01 ANALITICO / DETECCAO CAMERA
RECEPTOR_WEB_URL=http://185.130.61.3:5000
RECEPTOR_WEB_SENHA=
TERMINAL_NOTIFY_ENABLED=true
TERMINAL_NOTIFY_WORKERS=4
TERMINAL_NOTIFY_RETRIES=3
TERMINAL_CONTACT_ID=CV01

# Contabo Object Storage (mesmas credenciais do ConfVision Go)
CONTABO_S3_ACCESS_KEY=
CONTABO_S3_SECRET_KEY=
CONTABO_S3_ENDPOINT=https://usc1.contabostorage.com
CONTABO_S3_BUCKET=confvision
CONTABO_S3_REGION=us-east-1
CONTABO_S3_TENANT_ID=

# --- DVR gravacao continua (worker separado: python -u dvr_main.py) ---
MEDIAMTX_API_BASE=http://31.97.173.119:9997
MEDIAMTX_API_USER=dvr
MEDIAMTX_API_PASS=troque-esta-senha
DVR_RECORD_DIR=/recordings
DVR_SYNC_INTERVAL_SEC=30
DVR_SEGMENTO_MINUTOS_DEFAULT=5
DVR_STABLE_SEC=3
DVR_STORAGE_CACHE_TTL_SEC=300
DVR_UPLOAD_RETRIES=3
DVR_WORKER_VERSION=0.1.1
# false = record so via mediamtx.yml (sem PATCH API a cada sync)
DVR_MTX_SYNC_API=true

# --- Gravacao por movimento (worker separado: python -u motion_main.py) ---
MOTION_SYNC_INTERVAL_SEC=30
MOTION_WORKER_VERSION=0.1.0
MOTION_RECORD_DIR=/tmp/confvision/motion
MOTION_CLIP_MAX_SEC=300
MOTION_POST_ROLL_SEC=5
MOTION_FRAME_SKIP=3
MOTION_MIN_AREA=1500
MOTION_MOG2_HISTORY=300
MOTION_MOG2_THRESHOLD=25
MOTION_RECONNECT_SEC=5
MOTION_ANALYSIS_WIDTH=640

# --- Timelapse Inteligente (worker separado: python -u timelapse_main.py) ---
# Intervalo entre capturas de frame no modo timelapse (SEGUNDOS, nao minutos)
# Producao sugerida: 720s (12 min) x 60 frames = 12h reais -> 1 min de video
TIMELAPSE_FRAME_INTERVALO_SEG=720
TIMELAPSE_FRAMES_POR_SEGMENTO=60
# Teste no EasyPanel (8 min reais -> 24s de video): descomente e comente producao acima
# TIMELAPSE_FRAME_INTERVALO_SEG=20
# TIMELAPSE_FRAMES_POR_SEGMENTO=24

# --- Monitor falhas RTMP (legado: python -u rtmp_watch_main.py) ---
# Preferir confvision-rtmp-guard (auth + ban + falhas): python -u rtmp_guard_main.py
MTX_LOG_FILE=/recordings/mediamtx.log
RTMP_WATCH_JSON=/recordings/rtmp_falhas.json
RTMP_WATCH_HTTP_PORT=8099
RTMP_WATCH_MAX=500
RTMP_WATCH_DEDUPE_SEC=60

# --- Guard RTMP (auth HMAC + auto-ban) ---
RTMP_GUARD_HTTP_PORT=8100
RTMP_BAN_JSON=/recordings/rtmp_bans.json
RTMP_BAN_MAX_FAILS=20
RTMP_BAN_WINDOW_SEC=60
RTMP_BAN_TTL_SEC=3600
RTMP_AUTH_CACHE_SEC=45
RTMP_ALLOW_READ_OPEN=1
# Mesmo segredo na app Go ConfVision (RTMP_PUBLISH_SECRET)
RTMP_PUBLISH_SECRET=troque-este-segredo-longo
RTMP_GUARD_ADMIN_KEY=troque-esta-chave-admin
# Credenciais API MediaMTX (dvr worker)
MEDIAMTX_API_USER=dvr
MEDIAMTX_API_PASS=troque-esta-senha
# Na app Go ConfVision (outro servidor): IP/hostname da VPS alcançável
# RTMP_GUARD_URL=http://IP_DA_VPS:8100
# RTMP_GUARD_ADMIN_KEY=igual-ao-do-guard
# RTMP_PUBLISH_SECRET=igual-ao-do-guard
# Na app Go ConfVision: RTMP_WATCH_URL=http://foxpro_confvision-rtmp-watch:8099
