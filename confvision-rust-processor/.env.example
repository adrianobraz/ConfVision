# API Go ConfVision (control plane) — NÃO usar host Xano

CONFVISION_API_URL=https://SEU_HOST_DA_API

VIS_WORKER_API_KEY=



# MediaMTX RTSP (fallback se a API não enviar mediamtx_rtsp_base por câmera)

MEDIAMTX_RTSP_BASE=rtsp://127.0.0.1:8554

# Necessário para montar path cam/{hash12} quando rtsp_url_sec estiver vazio

RTMP_PUBLISH_SECRET=



# Identidade do processo Rust (métricas/health; distinto do worker lógico)

PROCESSOR_ID=rust-processor-01

PROCESSOR_HOSTNAME=

PROCESSOR_VERSION=0.1.0



# Identidade lógica do worker (ping + sync quando SHARD_MODE=worker_id) — alinhado ao Python

WORKER_ID=rust-processor-01

WORKER_TIPO=rust_processor



# Sharding (mesma semântica que ConfVision/sharding.py)

# auto | worker_id | hash

SHARD_MODE=worker_id

WORKER_SHARD_INDEX=-1

WORKER_SHARD_TOTAL=0



# Filtro de nó MediaMTX na API (vis_mediamtx_node_id); 0 = sem filtro

MEDIAMTX_NODE_ID=0



# Redis (opcional fase 1 — reservado)

REDIS_URL=



# S3 (opcional fase 1 — reservado)

S3_ENDPOINT=

S3_BUCKET=



# HTTP deste serviço

HTTP_HOST=0.0.0.0

HTTP_PORT=8090



LOG_LEVEL=info



# Hard safety limit local (NÃO é capacidade estimada). 0 = sem teto hard.

MAX_CAMERAS=10

# Fase 6.0 — capacidade dinâmica (dynamic | disabled)

CAPACITY_MODE=dynamic

CAPACITY_CPU_TARGET_PERCENT=80

CAPACITY_MEMORY_TARGET_PERCENT=80

CAPACITY_GPU_TARGET_PERCENT=80

CAPACITY_VRAM_TARGET_PERCENT=80

CAPACITY_MIN_SAMPLE_SEC=30

CAPACITY_SAFETY_FACTOR=0.80

CAPACITY_HISTORY_SIZE=120

CAPACITY_SAMPLE_INTERVAL_SEC=5

SYNC_INTERVAL_SEC=60

PING_INTERVAL_SEC=30



RTSP_CONNECT_TIMEOUT_SEC=15

RTSP_RECONNECT_SECONDS=10

RTSP_FRAME_TIMEOUT_SEC=30

FRAME_BUFFER_MAX=2



# Ping Go (campos compatíveis com vis_worker)

QUEUE_BACKEND=none



# Teste local sem RTSP (1 câmera simulada)

# RTSP_SIMULATE=1

