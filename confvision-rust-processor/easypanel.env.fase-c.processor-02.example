# 2º processor — Fase C4 (VPS só se houver CPU/RAM; ideal no dedicado)
# Novo app EasyPanel, imagem igual, domínio/porta diferente (ex. 8091 interno)
# Postgres: metade das câmeras com worker_id = rust-processor-pilot-02

CONFVISION_API_URL=https://vision.confmonit2.com.br
VIS_WORKER_API_KEY=SUBSTITUA
RTMP_PUBLISH_SECRET=SUBSTITUA

MEDIAMTX_RTSP_BASE=rtsp://foxpro_confvision:8554
MEDIAMTX_NODE_ID=1

PROCESSOR_ID=rust-processor-pilot-02
WORKER_ID=rust-processor-pilot-02
PROCESSOR_VERSION=0.1.0
WORKER_TIPO=rust_processor

SYNC_FILTER_WORKER_ID=true
MAX_CAMERAS=4

HTTP_HOST=0.0.0.0
HTTP_PORT=8090
LOG_LEVEL=info

SYNC_INTERVAL_SEC=60
PING_INTERVAL_SEC=30

LOAD_ADMISSION_ENABLED=1
LOAD_POLICY_MODE=admission
QUEUE_BACKEND=none
STREAM_RETRY_ENABLED=1

ANALYSIS_LEGACY_VPS=1
ANALYSIS_ONLY_ON_MOTION=1
MOTION_PROBE_KEYFRAME_ONLY=1
RTSP_IDLE_SUSPEND=1
MOTION_GATE_PROBE_MAX_FPS=0.5
MOTION_ANALYSIS_MAX_FPS=2
MOTION_FRAME_STRIDE=3
DECODE_FRAME_STRIDE=5
