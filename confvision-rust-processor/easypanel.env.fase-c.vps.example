# EasyPanel foxpro — Fase C (VPS sem GPU)
# Copiar para Environment do serviço rust-pilot + Redeploy
# Guia: docs/FASE_C.md

CONFVISION_API_URL=https://vision.confmonit2.com.br
VIS_WORKER_API_KEY=SUBSTITUA
RTMP_PUBLISH_SECRET=SUBSTITUA

MEDIAMTX_RTSP_BASE=rtsp://foxpro_confvision:8554
MEDIAMTX_NODE_ID=1

PROCESSOR_ID=rust-processor-pilot-01
WORKER_ID=rust-processor-pilot-01
PROCESSOR_VERSION=0.1.0
WORKER_TIPO=rust_processor

SYNC_FILTER_WORKER_ID=true
# Teto realista (capacity-report ~7–10 CPU decode); produção 2026-09 estava 30 — reduzir
MAX_CAMERAS=10

HTTP_HOST=0.0.0.0
HTTP_PORT=8090
LOG_LEVEL=info

SYNC_INTERVAL_SEC=60
PING_INTERVAL_SEC=30

# C3 — admission: bloqueia NOVAS câmeras quando capacity critical
LOAD_ADMISSION_ENABLED=1
LOAD_POLICY_MODE=admission

# D2 — fila eventos (copiar REDIS_URL do worker; senha só no EasyPanel)
# REDIS_URL=redis://default:SENHA@185.130.61.5:6379/0
# QUEUE_BACKEND=redis
# EVENT_QUEUE_KEY=confvision:eventos
# EVENT_QUEUE_MAX_SIZE=1000
QUEUE_BACKEND=none

# D3 — YOLO + captura (ver docs/FASE_D_D3_KICKOFF.md)
# YOLO_ENABLED=1
# YOLO_BACKEND=http
# YOLO_HTTP_URL=http://127.0.0.1:8091/v1/detect
# CAPTURE_ENABLED=1
# CAPTURE_WORKERS=2
# CAPTURE_DIR=/tmp/confvision

STREAM_RETRY_ENABLED=1

# Perfil CPU VPS (denso)
ANALYSIS_LEGACY_VPS=1
ANALYSIS_ONLY_ON_MOTION=1
MOTION_PROBE_KEYFRAME_ONLY=1
RTSP_IDLE_SUSPEND=1
MOTION_GATE_PROBE_MAX_FPS=0.5
MOTION_ANALYSIS_MAX_FPS=2
MOTION_FRAME_STRIDE=3
DECODE_FRAME_STRIDE=5

# Proibido: RUST_LOG, VIDEO_ACCELERATION=gpu, XANO_*
