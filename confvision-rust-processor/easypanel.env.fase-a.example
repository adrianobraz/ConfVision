# EasyPanel — Fase A: 1 câmera no rust-pilot (copiar para Environment + segredos reais)
# Ver docs/PILOTO_FASE_A.md

CONFVISION_API_URL=https://vision.confmonit2.com.br
VIS_WORKER_API_KEY=SUBSTITUA_PELA_CHAVE_DO_GO
RTMP_PUBLISH_SECRET=SUBSTITUA_PELO_SEGREDO_RTMP

MEDIAMTX_RTSP_BASE=rtsp://foxpro_confvision:8554
MEDIAMTX_NODE_ID=1

PROCESSOR_ID=rust-processor-pilot-01
WORKER_ID=rust-processor-pilot-01
PROCESSOR_VERSION=0.1.0
WORKER_TIPO=rust_processor

SYNC_FILTER_WORKER_ID=true
MAX_CAMERAS=10

HTTP_HOST=0.0.0.0
HTTP_PORT=8090
LOG_LEVEL=info

SYNC_INTERVAL_SEC=60
PING_INTERVAL_SEC=30
QUEUE_BACKEND=none

# Perfil CPU (piloto VPS)
ANALYSIS_LEGACY_VPS=1
ANALYSIS_ONLY_ON_MOTION=1
MOTION_PROBE_KEYFRAME_ONLY=1
RTSP_IDLE_SUSPEND=1
MOTION_GATE_PROBE_MAX_FPS=0.5
MOTION_ANALYSIS_MAX_FPS=2
MOTION_FRAME_STRIDE=3
DECODE_FRAME_STRIDE=5

# Admission: 0 = piloto/medir carga; 1 = bloqueia novas câmeras em capacity critical (ver docs/LOAD_ADMISSION.md)
LOAD_ADMISSION_ENABLED=0
LOAD_POLICY_MODE=advisory

# Relatório: GET /capacity-report — script scripts/capacity-report.sh
# Fase C (VPS): ver easypanel.env.fase-c.vps.example + docs/FASE_C.md

# Retry RTSP automático (404 / sem publisher) — docs/STREAM_RETRY_POLICY.md
STREAM_RETRY_ENABLED=1
SYNC_FILTER_WORKER_ID=true

# Não definir: RUST_LOG (conflita com LOG_LEVEL), VIDEO_ACCELERATION=gpu, XANO_*
