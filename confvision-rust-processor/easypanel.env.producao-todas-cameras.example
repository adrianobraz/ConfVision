# EasyPanel foxpro — produção TODAS câmeras analíticas (CPU VPS, A/B)
# Duplicar: pilot-a (WORKER_ID rust-processor-pilot-a-01) e pilot-b (…-b-02) conforme Postgres.
# Guia: deploy/tenant-stack/docs/IMPLANTAR_FASES_0_4.md

CONFVISION_API_URL=https://vision.confmonit2.com.br
VIS_WORKER_API_KEY=SUBSTITUA
RTMP_PUBLISH_SECRET=SUBSTITUA

MEDIAMTX_RTSP_BASE=rtsp://foxpro_confvision:8554
MEDIAMTX_NODE_ID=1

# Ajustar por app (deve bater com vis_camera.worker_id deste processor)
PROCESSOR_ID=rust-processor-pilot-a-01
WORKER_ID=rust-processor-pilot-a-01
PROCESSOR_VERSION=0.1.0
WORKER_TIPO=rust_processor

SYNC_FILTER_WORKER_ID=true
# 0 = sem teto hard; ou 15–25 por processor em VPS 4 vCPU — validar Fase 5
MAX_CAMERAS=0

HTTP_HOST=0.0.0.0
HTTP_PORT=8090
LOG_LEVEL=info

SYNC_INTERVAL_SEC=60
PING_INTERVAL_SEC=30

LOAD_ADMISSION_ENABLED=1
LOAD_POLICY_MODE=admission
LOAD_SHEDDING_ENABLED=1
LOAD_SHED_ENTER_PERCENT=90
LOAD_SHED_EXIT_PERCENT=82

# Fase 3 — descomente após REDIS_URL válido
# REDIS_URL=redis://default:SENHA@HOST:6379/0
# QUEUE_BACKEND=redis
# EVENT_QUEUE_KEY=confvision:eventos
# EVENT_QUEUE_MAX_SIZE=2000
QUEUE_BACKEND=none

# D3 — pipeline completo
YOLO_ENABLED=1
YOLO_BACKEND=http
YOLO_HTTP_URL=http://foxpro_rust-yolo-sidecar:8091
YOLO_HTTP_TIMEOUT_SEC=90
YOLO_INFER_ASYNC=1
YOLO_MAX_INFLIGHT=2
YOLO_INFER_SLOTS=2
YOLO_ONLY_ON_MOTION=1
YOLO_FRAME_STRIDE=10
CAPTURE_ENABLED=1
CAPTURE_WORKERS=2

STREAM_RETRY_ENABLED=1
STREAM_DELAY_404_SEC=120

ANALYSIS_LEGACY_VPS=1
ANALYSIS_ONLY_ON_MOTION=1
MOTION_PROBE_KEYFRAME_ONLY=1
RTSP_IDLE_SUSPEND=1
MOTION_GATE_PROBE_MAX_FPS=0.5
MOTION_ANALYSIS_MAX_FPS=2
MOTION_FRAME_STRIDE=3
DECODE_FRAME_STRIDE=5

# Proibido: XANO_*, RTSP_SIMULATE
