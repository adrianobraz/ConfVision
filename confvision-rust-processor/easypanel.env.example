# EasyPanel — piloto confvision-rust-processor (1 câmera RTSP real)
# Copie estas variáveis para Environment do serviço no EasyPanel.
# NÃO commitar valores reais (keys, segredos). Use placeholders na VPS.

# URL base da API Go ConfVision (control plane).
# Deve ser a mesma app que expõe /vis_camera_sync_ativas e /vis_worker_ping.
# NÃO use host *.xano.io — o serviço Rust rejeita Xano como API.
CONFVISION_API_URL=https://SUBSTITUA_PELA_URL_DA_APP_GO

# Mesma chave configurada na app Go (header X-Vis-Worker-Key).
VIS_WORKER_API_KEY=SUBSTITUA_PELA_CHAVE_DO_GO

# Igual app Go, MediaMTX e workers Python (Hashids path cam/{hash12}).
RTMP_PUBLISH_SECRET=SUBSTITUA_PELO_SEGREDO_RTMP

# RTSP do MediaMTX, acessível DE DENTRO do container Rust (hostname rede EasyPanel).
# Exemplo de forma: rtsp://NOME_SERVICO_MEDIAMTX:8554
MEDIAMTX_RTSP_BASE=rtsp://SUBSTITUA_HOST_MEDIAMTX:8554

# Identidade deste processor — deve ser ÚNICO e igual ao worker_id da câmera piloto no Postgres.
PROCESSOR_ID=rust-processor-pilot-01
WORKER_ID=rust-processor-pilot-01
PROCESSOR_VERSION=0.1.0
WORKER_TIPO=rust_processor

# Piloto: só câmeras com worker_id = PROCESSOR_ID; no máximo 1 stream.
# (Filtro principal: query sync com worker_id; alinhar Go se usar SYNC_FILTER_WORKER_ID no backend.)
SYNC_FILTER_WORKER_ID=true
MAX_CAMERAS=1

HTTP_HOST=0.0.0.0
HTTP_PORT=8090
LOG_LEVEL=info

# Alinhar com vis_mediamtx_node_id da câmera (foxpro costuma usar 1).
MEDIAMTX_NODE_ID=1
SYNC_INTERVAL_SEC=60
PING_INTERVAL_SEC=30
QUEUE_BACKEND=none

# Consumo CPU: perfil VPS (≈ worker Python FRAME_SKIP/MOTION_FRAME_SKIP) — recomendado piloto Hostinger 2–5 câmeras.
# ANALYSIS_LEGACY_VPS=1
# ANALYSIS_ONLY_ON_MOTION=1
# MOTION_PROBE_KEYFRAME_ONLY=1
# RTSP_IDLE_SUSPEND=1
# MOTION_GATE_PROBE_MAX_FPS=0.5
# MOTION_PERCENT_THRESHOLD=5
# MOTION_PIXEL_DIFF_THRESHOLD=8
# MOTION_ANALYSIS_MAX_FPS=2
# MOTION_FRAME_STRIDE=3
# DECODE_FRAME_STRIDE=5

MOTION_ANALYSIS_MAX_FPS=5
MOTION_FRAME_STRIDE=1
DECODE_FRAME_STRIDE=1
LOAD_ADMISSION_ENABLED=1

# NÃO definir RTSP_SIMULATE neste piloto (RTSP real via MediaMTX).
# NÃO definir MEDIAMTX_API_* — o Rust só consome RTSP, não a API HTTP do MediaMTX.
# NÃO definir XANO_BASE_URL, XANO_API_FRANQUEADO_PRO, REDIS_URL, S3_*.
