# =============================================================================
# PRODUÇÃO — capacidade automática (EasyPanel, um app por processor Rust)
# Ajuste WORKER_ID / PROCESSOR_ID por réplica (a-01, b-02, …).
# Deploy do binário com backpressure YOLO (branch atual core4-rust-pilot).
# =============================================================================

CONFVISION_API_URL=https://vision.confmonit2.com.br
VIS_WORKER_API_KEY=SUBSTITUA
RTMP_PUBLISH_SECRET=SUBSTITUA
MEDIAMTX_RTSP_BASE=rtsp://foxpro_confvision:8554
MEDIAMTX_NODE_ID=1

PROCESSOR_ID=rust-processor-pilot-a-01
WORKER_ID=rust-processor-pilot-a-01
WORKER_TIPO=rust_processor
SYNC_FILTER_WORKER_ID=true

# --- Capacidade do container (calibre por vCPU/RAM do plano EasyPanel) ---
CAPACITY_MODE=dynamic
CAPACITY_CPU_TARGET_PERCENT=75
CAPACITY_MEMORY_TARGET_PERCENT=80
CAPACITY_SAFETY_FACTOR=0.85
CAPACITY_SAMPLE_INTERVAL_SEC=5

# --- Automático: não abrir câmera nova se CPU/RAM critical; fila pending_admission ---
LOAD_POLICY_MODE=admission
LOAD_ADMISSION_ENABLED=1

# --- Último recurso: suspende analítico só se CPU/RAM >= LOAD_SHED_ENTER (não por “capacidade cheia”) ---
# Recomendado 0 em piloto; se 1, não combine com MAX_CAMERAS baixo sem calibrar admission.
LOAD_SHEDDING_ENABLED=0
LOAD_SHED_ENTER_PERCENT=88
LOAD_SHED_EXIT_PERCENT=72
LOAD_SHED_ENTER_SEC=90
LOAD_SHED_EXIT_SEC=180

# Teto por processor (0=ilimitado — evite em produção). Regra prática: ~3–5 câmeras / 4 vCPU com YOLO HTTP.
MAX_CAMERAS=12

HTTP_HOST=0.0.0.0
HTTP_PORT=8090
LOG_LEVEL=info
SYNC_INTERVAL_SEC=60
PING_INTERVAL_SEC=30

# --- Redis eventos (obrigatório produção analítica) ---
REDIS_URL=redis://default:SENHA@HOST:6379/0
QUEUE_BACKEND=redis
EVENT_QUEUE_KEY=confvision:eventos
EVENT_QUEUE_MAX_SIZE=2000

# --- YOLO sidecar (mesma rede Docker) + backpressure ---
YOLO_ENABLED=1
YOLO_BACKEND=http
YOLO_HTTP_URL=http://foxpro_rust-yolo-sidecar:8091
YOLO_HTTP_TIMEOUT_SEC=90
YOLO_INFER_ASYNC=1
YOLO_MAX_INFLIGHT=1
YOLO_GLOBAL_MAX_INFLIGHT=2
YOLO_BUSY_BACKOFF_MS=3000
YOLO_HEALTH_PROBE=1
YOLO_FRAME_STRIDE=12
ANALYSIS_ONLY_ON_MOTION=1
MOTION_FRAME_STRIDE=4
DECODE_FRAME_STRIDE=6
MOTION_ANALYSIS_MAX_FPS=1.5
MOTION_GATE_PROBE_MAX_FPS=0.35
RTSP_IDLE_SUSPEND=1

CAPTURE_ENABLED=1
CAPTURE_WORKERS=2
STREAM_RETRY_ENABLED=1
STREAM_DELAY_404_SEC=120
