# ConfVision MediaMTX Node V1 — variáveis (sem secrets reais)
# Dockerfile: confvision-mediamtx-node/deploy/Dockerfile.v1

# --- Control Plane (Guard consulta; MediaMTX não acessa PG) ---
CONFVISION_API_URL=https://vision.example.com
VIS_WORKER_API_KEY=
RTMP_PUBLISH_SECRET=
RTMP_GUARD_ADMIN_KEY=
RTMP_AUTH_CACHE_SEC=10

# --- Node identity (futuro sync vis_mediamtx_node) ---
CONFVISION_MEDIAMTX_NODE_ID=1
CONFVISION_CLUSTER_ID=foxpro-01
CONFVISION_REGION=br-south
CONFVISION_SERVER_ID=vps-ingest-01
CONFVISION_NODE_STATUS=ONLINE

# --- MediaMTX API (DVR + métricas scrape com basic via Guard) ---
MEDIAMTX_API_USER=dvr
MEDIAMTX_API_PASS=

# --- Volumes ---
# Montar /recordings: logs, bans, publish health, segmentos record
