# Host físico ConfVision / Proxmox (compose docker-compose.host.example.yml)

HOST_ID=srv_confvision_042
TENANT_ID=ct_cli_example
MAX_CAMERAS=200

MTX_RTMP_PORT=1935
MTX_RTSP_PORT=8554
RUST_HTTP_PORT=8090
YOLO_HTTP_PORT=8091

MTX_ENV_FILE=./.env.mtx
YOLO_ENV_FILE=./.env.yolo
RUST_ENV_FILE=./.env.rust

# U2 — quando usar registry (ver env/registry.env.example)
# COMPOSE_IMAGE_PULL=1

CONFVISION_API_URL=https://SUBSTITUA_PELA_URL_DA_APP_GO
VIS_WORKER_API_KEY=SUBSTITUA_PELA_CHAVE
RTMP_PUBLISH_SECRET=SUBSTITUA_PELO_SEGREDO_RTMP
MEDIAMTX_NODE_ID=1
