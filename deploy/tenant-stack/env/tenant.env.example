# Copiado para .env.tenant por scripts/tenant-init-env.sh
# NÃO commitar .env.tenant com segredos reais.

TENANT_ID=ct_cli_example
MAX_CAMERAS=200

# Portas publicadas no host (lab)
MTX_RTMP_PORT=1935
MTX_RTSP_PORT=8554
RUST_HTTP_PORT=8090

# Arquivos env gerados (paths relativos a deploy/tenant-stack)
MTX_ENV_FILE=./.env.mtx
PUBLISHER_ENV_FILE=./.env.publisher
RUST_ENV_FILE=./.env.rust

# Smoke test (scripts/tenant-stack-smoke.sh)
MEDIAMTX_RTSP_HOST=mtx
RUST_HEALTH_URL=http://127.0.0.1:8090/health

# Segredos compartilhados (substituir no .env.tenant)
CONFVISION_API_URL=https://SUBSTITUA_PELA_URL_DA_APP_GO
VIS_WORKER_API_KEY=SUBSTITUA_PELA_CHAVE
RTMP_PUBLISH_SECRET=SUBSTITUA_PELO_SEGREDO_RTMP
MEDIAMTX_NODE_ID=1
