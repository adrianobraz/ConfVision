# U2 — Registry único (futuro). Copiar para .env.registry (não commitar tokens).

# Ex.: ghcr.io/org/confvision-rust-processor
GHCR_PREFIX=ghcr.io/SUA_ORG/confvision-rust-processor
IMAGE_TAG=confvision-u0-2026-03-30

# Imagens derivadas (mesma tag family)
MEDIAMTX_IMAGE=ghcr.io/SUA_ORG/confvision-mediamtx:${IMAGE_TAG}
YOLO_IMAGE=ghcr.io/SUA_ORG/confvision-yolo-sidecar:${IMAGE_TAG}
RUST_IMAGE=ghcr.io/SUA_ORG/confvision-rust-processor:${IMAGE_TAG}

# docker login ghcr.io -u USER -p TOKEN
