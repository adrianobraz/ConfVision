# Worker Python — ingest / publicação RTMP (publisher)
# WORKER_ID distinto do Rust enquanto câmeras usam worker_id do processor no Postgres.
# Substituir ${TENANT_ID} ao gerar .env.publisher (tenant-init-env.sh).

XANO_BASE_URL=https://SUBSTITUA_PELA_URL_DA_APP_GO
VIS_WORKER_API_KEY=SUBSTITUA_PELA_CHAVE
EVENT_STORE=postgres
TERMINAL_NOTIFY_ENABLED=false

MEDIAMTX_RTSP_BASE=rtsp://mtx:8554
RTMP_PUBLISH_SECRET=SUBSTITUA_PELO_SEGREDO_RTMP

WORKER_ID=${TENANT_ID}-ingest
WORKER_VERSION=0.5.0
MEDIAMTX_NODE_ID=1
SYNC_INTERVAL_SEC=30
SYNC_USE_UNIFIED_API=true

# Ajustar MAX_CAMERAS ao tenant (ingest)
MAX_CAMERAS=200
SHARD_MODE=worker_id
WORKER_SHARD_INDEX=-1
WORKER_SHARD_TOTAL=0

# Redis central (produção) — ajustar URL
REDIS_URL=redis://default:SENHA@HOST:6379/0
CONFIG_CACHE_BACKEND=redis
CONFIG_CACHE_TTL_SEC=120
EVENT_QUEUE_BACKEND=redis
EVENT_QUEUE_KEY=confvision:eventos
EVENT_QUEUE_MAX_SIZE=5000

# Analítico legado — reduzir carga se Rust processa decode/motion
YOLO_ARCH=legacy
YOLO_DEVICE=
YOLO_ONLY_ON_MOTION=1
FRAME_SKIP=5
CAPTURE_DIR=/tmp/confvision
