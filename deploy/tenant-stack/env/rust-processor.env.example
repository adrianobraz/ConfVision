# confvision-rust-processor — serviço rust-processor no compose tenant
# PROCESSOR_ID = WORKER_ID = TENANT_ID (câmeras no Postgres com mesmo worker_id)

CONFVISION_API_URL=https://SUBSTITUA_PELA_URL_DA_APP_GO
VIS_WORKER_API_KEY=SUBSTITUA_PELA_CHAVE
RTMP_PUBLISH_SECRET=SUBSTITUA_PELO_SEGREDO_RTMP

# Hostname do serviço mtx na rede tenant (compose) ou foxpro_confvision (EasyPanel)
MEDIAMTX_RTSP_BASE=rtsp://mtx:8554

PROCESSOR_ID=${TENANT_ID}
WORKER_ID=${TENANT_ID}
PROCESSOR_VERSION=0.1.0
WORKER_TIPO=rust_processor

SHARD_MODE=worker_id
WORKER_SHARD_INDEX=-1
WORKER_SHARD_TOTAL=0

MAX_CAMERAS=200

HTTP_HOST=0.0.0.0
HTTP_PORT=8090
LOG_LEVEL=info

MEDIAMTX_NODE_ID=1
SYNC_INTERVAL_SEC=60
PING_INTERVAL_SEC=30
QUEUE_BACKEND=none

# ANALYSIS_LEGACY_VPS=1  → max_fps=2, strides 3/5 (VPS densa)
MOTION_ANALYSIS_MAX_FPS=5
MOTION_FRAME_STRIDE=1
DECODE_FRAME_STRIDE=1
LOAD_ADMISSION_ENABLED=1

# Proibido no piloto: RTSP_SIMULATE, XANO_*, REDIS_URL, S3_*, MEDIAMTX_API_*
