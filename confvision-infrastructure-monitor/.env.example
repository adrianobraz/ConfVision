# Segredo obrigatorio. Sem valor padrao.
MONITOR_API_SECRET=

# No EasyPanel o HTTPS fica no dominio. Use estes dois:
# MONITOR_BEHIND_PROXY=1
# MONITOR_LISTEN=0.0.0.0:8090
MONITOR_BEHIND_PROXY=0
MONITOR_LISTEN=127.0.0.1:8090
MONITOR_HOST_ROOT=/
MONITOR_TLS_CERT=
MONITOR_TLS_KEY=

MONITOR_SERVER_ID=vps-hostinger
MONITOR_SERVER_NOME=VPS Hostinger
MONITOR_INTERVAL_SEC=10

# Opcional. Vazio significa indisponivel, nao zero.
METRICS_LOG_PATH=
MEDIAMTX_API_BASE=
MEDIAMTX_API_USER=
MEDIAMTX_API_PASS=
REDIS_URL=
DOCKER_SOCKET=/var/run/docker.sock

# Cotas informadas. Sem estas variaveis nao ha capacidade configurada nem margem.
MONITOR_CPU_QUOTA=
MONITOR_RAM_QUOTA_MB=

ALERT_CPU_SUSPEITA=70
ALERT_CPU_ALERTA=85
ALERT_RAM_SUSPEITA=75
ALERT_RAM_ALERTA=90
ALERT_DISCO_SUSPEITA=80
ALERT_DISCO_ALERTA=90
ALERT_YOLO_P95_MS=400
