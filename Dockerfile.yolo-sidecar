# YOLO HTTP sidecar (D3) — EasyPanel: Dockerfile.yolo-sidecar, build path /
FROM python:3.11-slim-bookworm

ARG YOLO_MODEL=yolov8n.pt
ARG YOLO_DEVICE=cpu
ARG YOLO_HTTP_PORT=8091

ENV PIP_DEFAULT_TIMEOUT=300 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Torch CPU-only primeiro — evita baixar stack CUDA (~3GB) no build EasyPanel
RUN pip install --no-cache-dir --upgrade pip setuptools wheel \
    && pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu

COPY confvision-rust-processor/scripts/requirements-yolo-sidecar.txt /tmp/requirements-yolo-sidecar.txt
RUN pip install --no-cache-dir -r /tmp/requirements-yolo-sidecar.txt \
    && pip install --no-cache-dir --no-deps ultralytics==8.3.0

COPY confvision-rust-processor/scripts/yolo_sidecar.py /app/yolo_sidecar.py

ENV YOLO_MODEL=${YOLO_MODEL}
ENV YOLO_DEVICE=${YOLO_DEVICE}
ENV YOLO_HTTP_PORT=${YOLO_HTTP_PORT}
ENV YOLO_CONFIG_DIR=/tmp/Ultralytics

EXPOSE 8091

CMD ["python", "/app/yolo_sidecar.py"]
