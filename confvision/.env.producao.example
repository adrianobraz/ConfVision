# =============================================================================
# VPS EasyPanel — confvision-worker (PRODUÇÃO)
# Copie para Environment no EasyPanel. NÃO commitar senhas reais.
# =============================================================================

# --- API operacional (Go Core4 — substitui Xano para vis_*) ---
XANO_BASE_URL=https://vision.confmonit2.com.br

# Eventos via API Go → Postgres central + terminal dispatch no Go
EVENT_STORE=postgres

# Worker NÃO notifica terminal (responsabilidade do Go central)
TERMINAL_NOTIFY_ENABLED=false

# --- Stream / worker ---
MEDIAMTX_RTSP_BASE=rtsp://foxpro_confvision:8554
RTMP_PUBLISH_SECRET=<IGUAL_GO_E_MEDIAMTX>
WORKER_ID=worker-docker-01
WORKER_VERSION=0.4.0
MEDIAMTX_NODE_ID=1
SYNC_INTERVAL_SEC=30
SYNC_USE_UNIFIED_API=true

# --- YOLO / captura ---
YOLO_ONLY_ON_MOTION=1
YOLO_MOTION_MISS_FRAMES=2
YOLO_MODEL=yolov8n.pt
YOLO_CONF_DEFAULT=0.5
CLIP_DURACAO_SEG=20
CAPTURE_DIR=/tmp/confvision
UPLOAD_WORKERS=4
CAPTURE_WORKERS=8
MAX_CAMERAS=50
SHARD_MODE=auto

# --- Fila / cache Redis (recomendado produção) ---
EVENT_QUEUE_BACKEND=redis
REDIS_URL=redis://foxpro_redis:6379/0
CONFIG_CACHE_BACKEND=redis
CONFIG_CACHE_TTL_SEC=120

# --- Contabo S3 (eventos analíticos) ---
CONTABO_S3_ACCESS_KEY=
CONTABO_S3_SECRET_KEY=
CONTABO_S3_ENDPOINT=https://usc1.contabostorage.com
CONTABO_S3_BUCKET=confvision
CONTABO_S3_REGION=us-east-1
CONTABO_S3_TENANT_ID=

# --- ConfMonit API (somente_armado) ---
CONFMONIT_API_URL=http://185.130.61.4:2010

# --- NÃO usar no worker (legado — terminal no Go) ---
# RECEPTOR_WEB_URL=
# RECEPTOR_WEB_SENHA=
# POSTGRES_URL=  # opcional; eventos vão pela API Go
